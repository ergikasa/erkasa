{
  "name": "erkasa-render-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Turns a render spec (scenes: image + voice + word timings) into an MP4 with Remotion.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "tsx src/render-cli.ts",
    "sample": "tsx src/make-sample.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/make-demo.ts",
    "worker": "tsx src/worker.ts",
    "bench": "tsx src/bench.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/bundler": "4.0.537",
    "@remotion/cli": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "amqplib": "0.10.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.8",
    "@types/node": "22.15.30",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
