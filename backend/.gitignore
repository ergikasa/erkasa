# Copy this file to .env in the same folder and change the passwords.
# .env is ignored by Git. Never commit real secrets.

# ---------- PostgreSQL ----------
POSTGRES_DB=erkasa
POSTGRES_USER=erkasa
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# ---------- RabbitMQ ----------
RABBITMQ_USER=erkasa
RABBITMQ_PASSWORD=erkasa
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15672

# ---------- S3 storage (SeaweedFS locally, Cloudflare R2 in production) ----------
S3_ACCESS_KEY=erkasa-dev
S3_SECRET_KEY=change-me-s3-secret
S3_PORT=8333
S3_BUCKET=erkasa-dev
S3_REGION=us-east-1


JWT_SECRET=WHKPxsYSV08XlNQiOs7BnPd8TsYhaz0Qc2SqgOip59yLZZNF2cSMdfl501M5/EVV

# OAuth Client ID for "Sign in with Google" (Google Cloud Console -> Credentials). Not a secret.
GOOGLE_CLIENT_ID=251368112434-16lp3d1dt98p87rdokmmegcecsfnfkrg.apps.googleusercontent.com

# ---------- AI providers ----------
# mock = free fake output. Switch one at a time once its key is set.
PROVIDER_LLM=mock
PROVIDER_IMAGE=mock
PROVIDER_TTS=mock
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# https://fal.ai/dashboard/keys
FAL_KEY=
# https://clipdrop.co/apis/account  (PROVIDER_IMAGE=clipdrop)
CLIPDROP_API_KEY=
# PROVIDER_TTS=elevenlabs-azure needs both of these
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# voices at the same time = your ElevenLabs plan's limit (Free 2, Starter 3, Creator 5)
ELEVENLABS_MAX_CONCURRENT=2
# Azure portal -> Speech resource -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ---- render worker (5.5) ----
# angle = Chrome draws with the graphics card (Windows: ~1.7x faster). Empty = CPU only (servers without GPU).
RENDER_GL=angle
# browser tabs per video; on Ergi's PC 2 tabs + angle was fastest (empty = one per CPU core, max 8)
RENDER_CONCURRENCY=2
