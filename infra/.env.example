# Copy this file to .env in the same folder and change the passwords.
# .env is ignored by Git. Never commit real secrets.

# ---------- PostgreSQL ----------
POSTGRES_DB=erkasa
POSTGRES_USER=erkasa
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432

# ---------- RabbitMQ ----------
RABBITMQ_USER=erkasa
RABBITMQ_PASSWORD=erkasa
RABBITMQ_PORT=5673
RABBITMQ_UI_PORT=15672

# ---------- S3 storage (SeaweedFS locally, Cloudflare R2 in production) ----------
S3_ACCESS_KEY=erkasa-dev
S3_SECRET_KEY=change-me-s3-secret
S3_PORT=8333
S3_BUCKET=erkasa-dev
S3_REGION=us-east-1


JWT_SECRET=WHKPxsYSV08XlNQiOs7BnPd8TsYhaz0Qc2SqgOip59yLZZNF2cSMdfl501M5/EVV

# OAuth Client ID for "Sign in with Google" (Google Cloud Console -> Credentials). Not a secret.
GOOGLE_CLIENT_ID=251368112434-16lp3d1dt98p87rdokmmegcecsfnfkrg.apps.googleusercontent.com

# ---- payments: Paddle (phase 8) ----
# sandbox = test cards (no real money); production after Paddle approves your account
PADDLE_ENV=sandbox
# Developer tools -> Authentication -> Client-side tokens (test_... in sandbox). Public, safe in the browser.
PADDLE_CLIENT_TOKEN=
# Developer tools -> Notifications -> your webhook destination -> Secret key (pdl_ntfset_...). SECRET.
PADDLE_WEBHOOK_SECRET=
# Catalog -> Products -> each pack's price id (pri_...)
PADDLE_PRICE_STARTER=
PADDLE_PRICE_CREATOR=
PADDLE_PRICE_PRO=
